<?xml version="1.0" encoding="utf-8"?>
<!--
    WP22 Amendment 1: ApprovalTrampolineActivity layout.

    The approval flash (docs/design-system/components/UnlockFlash): a mint
    field over the whole translucent window with a ringed check in its
    centre. No text fields, no buttons, no PIN input — FR-018 guarantees the
    Subject device never prompts for a PIN during approval consumption.
    Both views stay invisible until UnlockSuccessEffect plays the flash.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/approval_trampoline_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="false"
    android:focusable="false">

    <View
        android:id="@+id/unlock_flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.0"
        android:background="@color/krypt_flash"
        android:importantForAccessibility="no" />

    <FrameLayout
        android:id="@+id/unlock_flash_mark"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center"
        android:alpha="0.0"
        android:background="@drawable/flash_ring"
        android:importantForAccessibility="no">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_flash_check" />
    </FrameLayout>

</FrameLayout>
