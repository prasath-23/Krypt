<?xml version="1.0" encoding="utf-8"?>
<!--
    Dark variant of Theme.Krypt: the same window, with light system-bar icons
    over the #121212 background (values-night/colors.xml).
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Krypt" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/krypt_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
    </style>
</resources>
