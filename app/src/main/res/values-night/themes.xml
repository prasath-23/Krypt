<?xml version="1.0" encoding="utf-8"?>
<!--
    Dark variant of Theme.Krypt. Material3 DayNight handles the palette swap;
    the explicit override here ensures a transparent status bar in both modes
    so Compose can draw behind the system bars (edge-to-edge).
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Krypt" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>
