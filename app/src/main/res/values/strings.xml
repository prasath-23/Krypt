<?xml version="1.0" encoding="utf-8"?>
<!--
    User-visible strings. All literal text in Kotlin / Compose MUST reference a
    key from this file (enforced by lint in WP18). Placeholders use the %1$s
    syntax for future localisation.

    Voice (docs/design-system/README.md): short, warm and adult. Serif
    statements end with a full stop ("Locked."); buttons are sentence-case
    verbs of at most three words; " · " is the only separator in status
    lines; toasts have no closing full stop; no exclamation marks.
-->
