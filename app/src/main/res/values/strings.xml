<?xml version="1.0" encoding="utf-8"?>
<!--
    User-visible strings. All literal text in Kotlin / Compose MUST reference a
    key from this file (enforced by lint in WP18). Placeholders use the %1$s
    syntax for future localisation.
-->
<resources>
    <string name="app_name">Krypt</string>
    <string name="wp01_placeholder_subtitle">Zero-Trust offline app locker</string>

    <!-- Notifications (WP07) -->
    <string name="notif_app_locked_title">New App Protected</string>
    <string name="notif_app_locked_body">%1$s (%2$s) has been locked by default</string>

    <!-- Overlay (WP09) -->
    <string name="overlay_icon_desc">Locked app icon</string>
    <string name="overlay_locked">Locked</string>
    <string name="overlay_ask_guardian">Ask Guardian</string>
    <string name="overlay_hint">Your Guardian will receive a secure request link.</string>
    <string name="overlay_footer">Krypt protects this app</string>

    <!-- Accessibility service (WP10) -->
    <string name="accessibility_service_label">Krypt Locker</string>
    <string name="accessibility_service_description">Krypt needs Accessibility access to see which app is being launched and cover locked apps with a Guardian-protected screen. Krypt does not read your app content and does not send any data off the device.</string>
    <string name="accessibility_service_summary">Guards your locked apps by covering them when launched.</string>

    <!-- Device Admin (WP11) -->
    <string name="device_admin_label">Krypt Device Admin</string>
    <string name="device_admin_description">Required so Krypt cannot be uninstalled without first being disabled here. Krypt does not use any other device-admin privilege.</string>
    <string name="device_admin_disable_warning">Disabling Krypt device admin will allow anyone to uninstall Krypt and remove protection from your locked apps. Are you sure?</string>
    <string name="device_admin_explanation">Krypt uses Device Admin to make itself harder to uninstall, so a determined user has to visit Settings first.</string>

    <!-- Onboarding (WP12) -->
    <string name="onboarding_title">Welcome to Krypt</string>
    <string name="onboarding_step_of">Step %1$d of %2$d</string>
    <string name="onboarding_back">Back</string>
    <string name="onboarding_next">Next</string>
    <string name="onboarding_finish">Finish</string>

    <string name="onboarding_step1_title">Accessibility access</string>
    <string name="onboarding_step1_body">Krypt needs Accessibility access so it can detect when a locked app is about to open and cover it. Krypt does not read your app content.</string>
    <string name="onboarding_step1_grant">Open Accessibility Settings</string>

    <string name="onboarding_step2_title">Display over other apps</string>
    <string name="onboarding_step2_body">Krypt needs permission to draw its Locker Screen over the app you are trying to open.</string>
    <string name="onboarding_step2_grant">Grant overlay permission</string>

    <string name="onboarding_step3_title">Device Admin</string>
    <string name="onboarding_step3_body">Activating Device Admin makes Krypt harder to uninstall without Guardian approval. Krypt does not use any other admin privilege.</string>
    <string name="onboarding_step3_grant">Activate Device Admin</string>

    <string name="onboarding_step4_title">Notifications</string>
    <string name="onboarding_step4_body">Krypt posts a notification when a new app gets auto-locked. On Android 13+ this needs your permission.</string>
    <string name="onboarding_step4_grant">Allow notifications</string>

    <string name="onboarding_step5_title">Battery optimisation</string>
    <string name="onboarding_step5_body">Krypt must stay running in the background. Grant the battery-optimisation exemption so the OS does not kill it while your screen is off.</string>
    <string name="onboarding_step5_grant">Open battery settings</string>

    <!-- Home (WP12) -->
    <string name="home_pairing_title">Guardian pairing</string>
    <string name="home_not_paired">Not paired yet</string>
    <string name="home_locked_title">Locked apps</string>
    <string name="home_locked_count">%1$d apps protected</string>

    <!-- Pairing (WP13) -->
    <string name="role_chooser_title">Choose this device\'s role</string>
    <string name="role_chooser_body">Decide now whether this device is the one being locked (Subject) or the one holding the PIN (Guardian).</string>
    <string name="role_chooser_footer">You can only choose once. To switch roles later, uninstall and reinstall Krypt.</string>
    <string name="role_guardian_title">Guardian</string>
    <string name="role_guardian_body">This device will hold the PIN and approve unlock requests.</string>
    <string name="role_subject_title">Subject</string>
    <string name="role_subject_body">This device will be locked by Krypt; approvals come from the Guardian.</string>
    <string name="role_choose">Choose</string>

    <string name="pair_subject_title">Pair with your Guardian</string>
    <string name="pair_subject_body">Generate a pairing link and share it with your Guardian device. Keep this app open until pairing completes.</string>
    <string name="pair_display_name_label">Display name</string>
    <string name="pair_generate">Generate pairing link</string>
    <string name="pair_share">Share via…</string>
    <string name="pair_waiting">Waiting for your Guardian’s reply…</string>

    <string name="pair_guardian_title">Pair with a Subject device</string>
    <string name="pair_guardian_body">%1$s wants to pair with this device. Set a PIN for unlock approvals.</string>
    <string name="pair_pin_label">Set 4–8 digit PIN</string>
    <string name="pair_pin_confirm_label">Confirm PIN</string>
    <string name="pair_guardian_confirm">Complete pairing + send reply</string>
    <string name="pair_error">Pairing error: %1$s</string>

    <string name="paired_verifying">Verifying pairing reply…</string>
    <string name="paired_success">Paired with %1$s!</string>
    <string name="paired_error">Pairing reply rejected: %1$s</string>
</resources>
