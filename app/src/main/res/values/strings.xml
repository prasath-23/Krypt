    <!-- Accessibility service (WP10) -->
    <string name="accessibility_service_label">Krypt Locker</string>
    <string name="accessibility_service_description">Krypt needs Accessibility access to see which apps are on screen and block locked apps until your Guardian approves. For apps your Guardian gives repeating time, Krypt counts the minutes they are used, on this device only. When an app\'s time is nearly up, Krypt shows how long is left over it, and closes the app when the time ends. Krypt does not read your app content and does not send any data off the device.</string>
