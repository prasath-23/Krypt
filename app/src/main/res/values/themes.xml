<?xml version="1.0" encoding="utf-8"?>
<!--
    Krypt window themes. Compose draws everything else (ui/theme/); these set
    only what the window needs before Compose runs. The window background is
    the theme's `background` token (values/colors.xml, values-night/colors.xml),
    so a screen's very first frame is already its finished background and
    nothing flashes. The Appearance setting (System default / Light / Dark)
    picks values or values-night through the app's night mode.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Krypt" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/krypt_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
    </style>

    <!--
        Amendment 2: LockScreenActivity. Its first frame is the plain theme
        background, which already hides the locked app before Compose draws.
    -->
    <style name="Theme.Krypt.LockScreen" parent="Theme.Krypt" />

    <!--
        WP22 Amendment 1: Translucent no-UI theme for ApprovalTrampolineActivity.
        The trampoline's job is silent consumption + the approval flash; it
        must not flash an opaque window before the flash effect runs.
    -->
    <style name="Theme.Krypt.Trampoline" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
