<?xml version="1.0" encoding="utf-8"?>
<!--
    Krypt — AndroidManifest.xml

    CRITICAL INVARIANT (FR-005 / SC-008):
        This manifest MUST NOT declare `android.permission.INTERNET`.
        It MUST NOT declare any network-adjacent permission (ACCESS_NETWORK_STATE,
        ACCESS_WIFI_STATE, CHANGE_NETWORK_STATE). Krypt is an offline-only,
        air-gapped locker; the absence of these permissions is the auditable
        proof to users and reviewers that no telemetry can ever be shipped.

    The ManifestAuditTest.kt unit test in src/test/ parses this file and fails
    the build if an INTERNET-adjacent permission appears. Do not add these.

    WP-by-WP note: only MainActivity is active in WP01. Receivers, services,
    Guardian activity, and watchdog are declared in WP07-WP16 as those WPs land.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================================ -->
    <!-- PERMISSIONS — see polaris-specs/001-krypt-app-locker/spec.md  -->
    <!-- ============================================================ -->

    <!-- FR-001 / FR-002: overlay that covers locked apps (WP09). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- FR-004: post the Security-Alerts notification on lock events (WP07). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Enumerate installed packages so the Accessibility Service can check lock
         state per package and the PackageReceiver can resolve display names.
         This permission triggers a Play Store review if distribution switches
         from sideload to Play; documented in research.md R6. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
                     tools:ignore="QueryAllPackagesPermission" />

    <!-- FR-010: foreground service that supervises the Accessibility Service (WP16). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- API 34+: specialUse subtype required; see research.md R8. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- API 29-33: dataSync fallback for the same FGS. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Re-start the Accessibility Service after device reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- FR-010: surviving Doze requires user-granted battery-optimisation ignore. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- FR-012: DeviceAdmin-backed uninstall friction (WP11).
         Requires the device to support device-admin provisioning. -->
    <uses-feature android:name="android.software.device_admin"
                  android:required="true" />

    <!-- ============================================================ -->
    <!-- APPLICATION                                                  -->
    <!-- ============================================================ -->
    <application
        android:name=".KryptApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Krypt">

        <!-- Main launcher Activity. Full Compose host + onboarding wizard wired
             in WP12; WP01 ships only a placeholder greeting. -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Krypt">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WP16: Watchdog foreground service (FR-010 battery survival). -->
        <service
            android:name=".service.KryptWatchdogService"
            android:exported="false"
            android:foregroundServiceType="specialUse|dataSync">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="accessibilityServiceSupervisor" />
        </service>

        <!-- WP14 + WP21: Guardian Activity (krypt:// deep-link host).
             Note: krypt://approve is handled by ApprovalTrampolineActivity
             below (Amendment 1 WP22 — silent Subject-side consumption);
             approve is intentionally absent from this intent-filter. -->
        <activity
            android:name=".ui.guardian.GuardianActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Krypt">
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="krypt" android:host="request" />
                <data android:scheme="krypt" android:host="paired" />
                <data android:scheme="krypt" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- WP22 Amendment 1: silent approval-URL trampoline. Translucent
             theme, no input surface (FR-018). Runs ApprovalConsumer and
             plays the 500 ms green flash + haptic + toast, then finishes. -->
        <activity
            android:name=".subject.ApprovalTrampolineActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Krypt.Trampoline">
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="krypt" android:host="approve" />
            </intent-filter>
        </activity>

        <!-- WP11: Device Admin (FR-012 uninstall friction). -->
        <receiver
            android:name=".service.KryptDeviceAdminReceiver"
            android:label="@string/device_admin_label"
            android:description="@string/device_admin_description"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- WP10: Accessibility Service (FR-001 interception). -->
        <service
            android:name=".service.AppLockerAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- WP08: Default-Deny package receiver (FR-003, FR-004). -->
        <receiver
            android:name=".receiver.PackageReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- Disable WorkManager's auto-init so KryptApplication.workManagerConfiguration
             (HiltWorkerFactory) is used instead of the default factory. Without this,
             InitializationProvider fires before Application.onCreate() and AccessibilityHealthWorker
             gets NoSuchMethodException because Hilt hasn't wired its factory yet. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="@string/androidx_startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
